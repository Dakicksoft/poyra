<?xml version="1.0" encoding="utf-8" ?>
<!--
  Düz HTTP VARSAYILAN OLARAK YASAK. Saha cihazı tahsilat verisi taşır; şifresiz bir
  bağlantı, aynı Wi-Fi'daki birinin tutarları görmesi ve değiştirmesi demektir.

  İstisna yalnız GELİŞTİRME adresleridir:
    · 10.0.2.2  — Android emülatöründen ana makine
    · localhost — 'adb reverse' tüneli
  Bu adresler cihazın kendi makinesidir; internete çıkmaz.

  Blanket 'usesCleartextTraffic=true' BİLİNÇLİ OLARAK KULLANILMADI: o ayar, üretim
  sunucusuna yanlışlıkla http:// ile bağlanmayı da sessizce kabul ederdi.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
