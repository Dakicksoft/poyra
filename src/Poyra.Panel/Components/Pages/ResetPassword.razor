@page "/parola-sifirla"
@layout AuthLayout
@attribute [AllowAnonymous]

<PageTitle>Parola sıfırlama — Poyra</PageTitle>

<div class="login">
    <h2 class="auth-title">Yeni parola</h2>
    <p class="auth-lead">Yeni parolanızı belirleyin.</p>


    @if (HataText(Hata) is { } hataMesaj)
    {
        <div class="alert err" role="alert">@hataMesaj</div>
    }

    @if (string.IsNullOrEmpty(Belirteç))
    {
        <div class="card">
            <p>Bu sayfaya e-postanızdaki bağlantı ile gelmelisiniz.</p>
            <p class="hint"><a href="/parola-unuttum">Yeni bağlantı iste</a></p>
        </div>
    }
    else
    {
        <form method="post" action="/parola-sifirla" class="card">
            <AntiforgeryToken />
            <input type="hidden" name="belirteç" value="@Belirteç" />
            <label>
                Yeni parola
                <input type="password" name="password" required minlength="10"
                       autocomplete="new-password" autofocus />
            </label>
            <label>
                Yeni parola (tekrar)
                <input type="password" name="passwordRepeat" required minlength="10"
                       autocomplete="new-password" />
            </label>
            <p class="hint">En az 10 karakter. Kaydedince açık tüm oturumlarınız kapanır.</p>
            <button type="submit" class="primary">Parolayı değiştir</button>
        </form>
    }

    <p class="login-links"><a href="/giris">Girişe dön</a></p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "belirteç")]
    private string? Belirteç { get; set; }

    [SupplyParameterFromQuery(Name = "hata")]
    private string? Hata { get; set; }

    private static string? HataText(string? kod) => kod switch
    {
        null or "" => null,
        "parola-eslesmiyor" => "Parolalar eşleşmiyor — iki alana da aynı parolayı yazın.",
        "parola-kurali" => "Parola en az 10 karakter olmalı.",
        "belirteç-gecersiz" => "Bağlantı geçersiz ya da süresi dolmuş. Yeni bir sıfırlama bağlantısı isteyin.",
        _ => "İşlem tamamlanamadı. Lütfen yeniden deneyin.",
    };
}
