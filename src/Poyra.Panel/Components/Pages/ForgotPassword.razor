@page "/parola-unuttum"
@layout AuthLayout
@attribute [AllowAnonymous]

<PageTitle>Parolamı unuttum — Poyra</PageTitle>

<div class="login">
    <h2 class="auth-title">Parolamı unuttum</h2>
    <p class="auth-lead">Kayıtlı e-posta adresinize sıfırlama bağlantısı gönderelim.</p>


    @if (SonucText(Sonuc) is { } sonucMesaj)
    {
        <div class="alert ok" role="status">@sonucMesaj</div>
    }
    @if (HataText(Hata) is { } hataMesaj)
    {
        <div class="alert err" role="alert">@hataMesaj</div>
    }

    <form method="post" action="/parola-unuttum" class="card">
        <AntiforgeryToken />
        <label>
            E-posta
            <input type="email" name="email" required autocomplete="username" autofocus />
        </label>
        <p class="hint">
            Adres kayıtlıysa 1 saat geçerli, tek kullanımlık bir sıfırlama bağlantısı
            gönderilir. Bağlantıyı kullandığınızda açık tüm oturumlarınız kapanır.
        </p>
        <button type="submit" class="primary">Sıfırlama bağlantısı gönder</button>
    </form>

    <p class="login-links"><a href="/giris">Girişe dön</a></p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "sonuc")]
    private string? Sonuc { get; set; }

    [SupplyParameterFromQuery(Name = "hata")]
    private string? Hata { get; set; }

    private static string? HataText(string? kod) => kod switch
    {
        null or "" => null,
        "gecersiz-eposta" => "E-posta adresi geçerli görünmüyor — kontrol edip yeniden deneyin.",
        _ => "İşlem tamamlanamadı. Lütfen yeniden deneyin.",
    };

    private static string? SonucText(string? kod) => kod switch
    {
        null or "" => null,
        _ => "İşlem tamamlandı.",
    };
}
