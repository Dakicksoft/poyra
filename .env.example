# Poyra üretim ortam değişkenleri — bu dosyayı `.env` olarak kopyalayın.
#
# Anahtarları ELLE YAZMAYIN; üretmek için:
#   ./scripts/anahtar-uret.sh >> .env
#
# .env dosyası ASLA depoya girmez (.gitignore'da). Kurumsal kurulumda bunun yerine
# secret manager (Docker secrets, Vault, KMS) kullanın.

# --- Veritabanı --------------------------------------------------------------
POSTGRES_DB=poyra
# Sahip rol parolası — YALNIZ migration ve bakım için kullanılır
POSTGRES_PASSWORD=
# Uygulama rolü (poyra_app) parolası — RLS'e tabi rol, uygulama bununla bağlanır
POYRA_APP_PASSWORD=

# --- Sırlar (her biri base64, 32 bayt; anahtar-uret.sh üretir) ---------------
# Konnektör kimlikleri + webhook imza sırları
POYRA_CREDENTIAL_KEY=
# Panel/API oturum belirteçleri
POYRA_JWT_KEY=
# Kart zarfı — DİĞERLERİNDEN AYRI olmalı (sızıntı yalıtımı)
POYRA_VAULT_KEY=
# Platform uçları (işyeri açma, BIN kataloğu) — uzun ve rastgele olsun
POYRA_PLATFORM_ADMIN_KEY=

# --- Adresler (ters vekilin dışarıya verdiği adresler) ----------------------
# Banka callback'leri BU adrese döner — yanlışsa ödemeler sonuçlanmaz
POYRA_PUBLIC_BASE_URL=https://api.ornek.com
POYRA_PANEL_BASE_URL=https://panel.ornek.com
POYRA_CHECKOUT_BASE_URL=https://odeme.ornek.com

# --- Yerel port eşlemeleri (ters vekil bunlara bağlanır) --------------------
API_PORT=5080
PANEL_PORT=5090
CHECKOUT_PORT=5095

# --- E-Posta (boş bırakılırsa postalar GÖNDERİLMEZ, yalnız günlüğe yazılır) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=poyra@ornek.com
